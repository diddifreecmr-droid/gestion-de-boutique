{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "config",
    "eslint-rules/*.d.ts",
    "scripts/*.d.mts",
    "tests/lint",
    "tests/scripts"
  ]
}
