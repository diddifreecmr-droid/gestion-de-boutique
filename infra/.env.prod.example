# Variables de la stack de PRODUCTION (infra/docker-compose.prod.yml). VALEURS FACTICES :
# ne jamais les utiliser telles quelles. Dans Portainer : Stacks → la stack → « Environment
# variables » (une ligne par variable). Procédure : docs/deploiement.md.
#
# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(48))"
# (ou : openssl rand -base64 48 | tr -d '/+=' ) — lettres, chiffres, « - » et « _ » seulement.

# --- Accès public (PROVISOIRE) ---------------------------------------------------------------
# Port HTTP du VPS publié par Caddy (80/443 appartiennent à Nginx Proxy Manager). Doit être
# identique au port de la cible du rewrite de frontend/vercel.json. À retirer à la bascule
# vers le nom de domaine (docs/deploiement.md).
PUBLIC_HTTP_PORT=8088

# --- Base PostgreSQL -------------------------------------------------------------------------
POSTGRES_USER=boutique
# Lettres, chiffres, « - », « _ » seulement : le mot de passe est inséré tel quel dans l'URL de
# connexion de l'API (DATABASE_URL). Fixé à la création du volume pg_data : le changer ensuite
# demande un ALTER ROLE (voir docs/deploiement.md).
POSTGRES_PASSWORD=remplacer-par-un-secret-genere-0000000000
POSTGRES_DB=boutique

# --- API -------------------------------------------------------------------------------------
# Secret de signature des jetons (HS256), au moins 32 octets. Le changer déconnecte tout le monde.
JWT_SECRET=remplacer-par-un-secret-genere-de-48-caracteres-00000000
# Facultatif : DEBUG | INFO | WARNING | ERROR | CRITICAL (défaut INFO).
LOG_LEVEL=INFO
# Facultatif : nombre de processus uvicorn (défaut 1 ; la limitation de débit de /auth/* est
# comptée par processus, 1 est le réglage le plus strict).
API_WORKERS=1
# Sous-réseau du réseau Docker interne. Doit être libre sur le VPS (docker network inspect).
# Caddy y est déclaré proxy de confiance (AUTH_TRUSTED_PROXIES).
INTERNAL_SUBNET=172.29.57.0/24

# --- Stockage objet Silo (S3) ----------------------------------------------------------------
S3_ROOT_USER=boutique-prod
# Au moins 8 caractères ; lettres, chiffres, « - », « _ » (inséré dans une URL par silo-init).
S3_ROOT_PASSWORD=remplacer-par-un-secret-genere-1111111111
S3_BUCKET=attachments
# Compte de service de l'API dans Silo (créé par silo-init, limité au bucket : lecture et
# écriture, ni suppression ni administration). Différent du compte racine ci-dessus.
# Identifiant : 3 à 128 caractères ; secret : au moins 8 caractères (lettres, chiffres, - et _).
S3_API_ACCESS_KEY=boutique-api
S3_API_SECRET_KEY=remplacer-par-un-secret-genere-2222222222
# Facultatif : durée des liens signés vers les pièces jointes, en secondes (5 à 3600, défaut 60).
ATTACHMENT_LINK_TTL_SECONDS=60

# --- Sauvegardes (specs § 9.2, étape 1 : sur le VPS) -----------------------------------------
# Nombre de copies quotidiennes gardées (défaut 30).
BACKUP_KEEP=30
# Heure de la sauvegarde de nuit, UTC, HH:MM (défaut 01:30 = 02:30 à Douala).
BACKUP_TIME_UTC=01:30

# --- Facultatif ------------------------------------------------------------------------------
# Version affichée dans l'application (vide : version de package.json + date du build).
APP_VERSION=
