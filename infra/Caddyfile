# Caddy de production (T25, specs § 4.7, § 7.3, § 8.4). Copié dans l'image caddy par
# frontend/Dockerfile.
#
# Caddy écoute en HTTP simple sur :80 : le HTTPS est terminé EN AMONT, par Vercel (relais
# /api/* de frontend/vercel.json) aujourd'hui, puis par Nginx Proxy Manager et un nom de
# domaine (seul accès autorisé à terme, voir docs/deploiement.md § « Bascule »). Les ports
# 80/443 du VPS appartiennent à Nginx Proxy Manager.
#
# Sert le build du frontend (fallback SPA) et proxifie /api/* vers le conteneur api.
{
	auto_https off
	# Pas d'interface d'administration exposée (rechargement : redémarrer le conteneur).
	admin off
}

http://:80 {
	encode zstd gzip

	# En-têtes de sécurité (specs § 8.4), pour toutes les réponses (HSTS : posé par le
	# terminateur HTTPS en amont). CSP : scripts du seul site ;
	# style-src accepte « unsafe-inline » pour les règles @page des reçus (élément <style> rendu
	# par React, specs § 9.1). Aucun script inline n'est permis.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# API : jamais en cache (specs § 7.3, RG-T25). X-Forwarded-For est posé par Caddy ; l'API
	# ne le lit que si la connexion vient du réseau interne (AUTH_TRUSTED_PROXIES).
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy api:8000 {
			health_uri /api/v1/health
			health_interval 30s
		}
	}

	# Frontend (specs § 7.3) :
	# - /assets/* : noms à empreinte (changent à chaque version) → cache 24 h au plus ;
	# - tout le reste (index.html, sw.js, manifest, icônes, routes de l'application) :
	#   « no-cache » = toujours revalidé auprès du serveur avant usage.
	handle {
		root * /srv
		@hashed path /assets/*
		@fresh not path /assets/*
		header @hashed Cache-Control "public, max-age=86400, immutable"
		header @fresh Cache-Control "no-cache"
		# Fallback SPA : une route inconnue sert index.html (le routeur React prend la suite).
		try_files {path} /index.html
		file_server
	}
}
