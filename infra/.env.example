# Infrastructure de développement locale — identifiants FACTICES.
# Copier vers infra/.env (ignoré par git) : cp infra/.env.example infra/.env
# Ne jamais réutiliser ces valeurs ailleurs qu'en local.
# Toute variable absente fait échouer `docker compose` (aucune valeur par défaut).

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=boutique
POSTGRES_PASSWORD=boutique-dev-password
# Base de développement
POSTGRES_DB=boutique
# Base séparée pour les tests (créée par postgres/init/01-create-test-db.sh)
POSTGRES_TEST_DB=boutique_test
# Port publié sur 127.0.0.1
POSTGRES_PORT=5432

# --- Stockage objet (Silo, fork de MinIO, API S3) -----------------------
# Mot de passe : 8 caractères minimum (exigence MinIO)
MINIO_ROOT_USER=boutique-dev
MINIO_ROOT_PASSWORD=boutique-dev-secret
# Ports publiés sur 127.0.0.1 : API S3 et console web
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket privé des pièces jointes (créé par le service minio-init)
S3_BUCKET=attachments
