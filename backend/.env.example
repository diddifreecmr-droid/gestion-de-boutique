# Copier en `backend/.env` (jamais versionné) ou définir ces variables dans l'environnement.
# Toute valeur manquante ou invalide arrête le démarrage avec un message explicite.

# Obligatoire. Environnement d'exécution : dev | test | prod
# (en prod, la documentation OpenAPI n'est pas exposée).
ENVIRONMENT=dev

# Facultatif. Préfixe de toutes les routes de l'API (commence par « / », sans « / » final).
API_PREFIX=/api/v1

# Facultatif. Niveau de journalisation du code applicatif : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Facultatif. Adaptateur de persistance : memory | postgres.
# Absent : memory si ENVIRONMENT=test, postgres sinon. memory est interdit en prod.
PERSISTENCE_BACKEND=postgres

# Obligatoire avec PERSISTENCE_BACKEND=postgres. URL SQLAlchemy (pilote psycopg 3), secrète.
# Valeurs de dev : voir infra/README.md (Postgres local de infra/docker-compose.dev.yml).
DATABASE_URL=postgresql+psycopg://boutique:boutique-dev-password@127.0.0.1:5432/boutique

# Tests uniquement (lue par pytest, jamais par l'application) : base dédiée, vidée à chaque test.
# uv run pytest tests/contracts tests/infrastructure/postgres --backend=postgres
TEST_DATABASE_URL=postgresql+psycopg://boutique:boutique-dev-password@127.0.0.1:5432/boutique_test

# Obligatoire. Secret de signature des jetons d'accès (HS256), au moins 32 octets.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))" — jamais versionné.
JWT_SECRET=

# Facultatif. Durée du jeton d'accès en minutes (1 à 60).
ACCESS_TOKEN_TTL_MINUTES=15

# Facultatif. Inactivité maximale d'une session de boutique, en jours (1 à 365) : chaque
# rafraîchissement la repousse.
REFRESH_TOKEN_TTL_DAYS=30

# Facultatif. Durée absolue d'une session d'administrateur plateforme, en heures (1 à 24).
ADMIN_SESSION_TTL_HOURS=8

# Facultatif. Limitation de débit des routes /auth/* (specs § 8.1), comptée en mémoire par
# processus. Absent : active, sauf ENVIRONMENT=test. Au-delà : 429 RATE_LIMITED + Retry-After
# (details.retry_after en secondes). Seuils entiers ≥ 1 ; /auth/logout n'est pas limité.
# AUTH_RATE_LIMIT_ENABLED=true
# Connexions par minute et par adresse IP.
AUTH_RATE_LIMIT_LOGIN_PER_IP=10
# Connexions par numéro (forme E.164) sur la fenêtre ci-dessous, quelles que soient les IP.
AUTH_RATE_LIMIT_LOGIN_PER_PHONE=5
AUTH_RATE_LIMIT_PHONE_WINDOW_MINUTES=15
# Rafraîchissements de session par minute et par adresse IP.
AUTH_RATE_LIMIT_REFRESH_PER_IP=30
# Changements de code par minute et par adresse IP.
AUTH_RATE_LIMIT_CHANGE_PIN_PER_IP=10
# Proxys de confiance (IP ou CIDR, séparés par des virgules ; vide par défaut). X-Forwarded-For
# n'est lu que si la connexion vient de l'un d'eux. En prod, déclarer Caddy (T25), sinon tous
# les clients partagent le compteur de l'IP du proxy. Exemple : 172.18.0.0/16,127.0.0.1
# AUTH_TRUSTED_PROXIES=
